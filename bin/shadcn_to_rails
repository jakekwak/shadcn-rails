# ---------------------------------------------------------------------------
# Fetcher
# ---------------------------------------------------------------------------

def fetch_registry(name, style="new-york", url=None):
    """Fetch component/block data from shadcn registry."""
    target_url = url or f"{REGISTRY_BASE}/{name}.json"
    print(f"  Fetching: {target_url}")
    req = urllib.request.Request(target_url, headers={"User-Agent": "shadcn-to-rails/1.0"})
    try:
        with urllib.request.urlopen(req) as resp:
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        print(f"  ERROR: HTTP {e.code} for {target_url}")
        return None
    except Exception as e:
        print(f"  ERROR: {e}")
        return None


def fetch_github(github_urls):
    """Fetch TSX/JSX files from GitHub URLs.

    Supports:
      - File URL:      https://github.com/user/repo/blob/branch/path/file.tsx
      - Directory URL: https://github.com/user/repo/tree/branch/path/dir
      - Raw URL:       https://raw.githubusercontent.com/user/repo/branch/path/file.tsx

    Returns registry-compatible data dict, or None on failure.
    """
    collected = []  # list of (filename, content, original_url)

    for url in github_urls:
        url = url.rstrip("/")

        # Convert blob URL → raw URL
        # https://github.com/user/repo/blob/branch/path → https://raw.githubusercontent.com/user/repo/branch/path
        if "github.com" in url and "/blob/" in url:
            raw_url = url.replace("github.com", "raw.githubusercontent.com").replace("/blob/", "/")
            print(f"  Fetching: {url}")
            try:
                req = urllib.request.Request(raw_url, headers={"User-Agent": "shadcn-to-rails/1.0"})
                with urllib.request.urlopen(req) as resp:
                    content = resp.read().decode("utf-8")
                filename = raw_url.split("/")[-1]
                collected.append((filename, content, url))
                print(f"  Loaded: {filename}")
            except Exception as e:
                print(f"  ERROR fetching {url}: {e}")
                continue

        # Directory URL → use GitHub API to list files, then fetch each
        elif "github.com" in url and "/tree/" in url:
            # https://github.com/user/repo/tree/branch/path → API: /repos/user/repo/contents/path?ref=branch
            parts = url.replace("https://github.com/", "").split("/")
            user, repo = parts[0], parts[1]
            # parts[2] == "tree", parts[3] == branch, parts[4:] == path
            branch = parts[3]
            dir_path = "/".join(parts[4:]) if len(parts) > 4 else ""
            api_url = f"https://api.github.com/repos/{user}/{repo}/contents/{dir_path}?ref={branch}"
            print(f"  Listing directory: {url}")
            try:
                req = urllib.request.Request(api_url, headers={
                    "User-Agent": "shadcn-to-rails/1.0",
                    "Accept": "application/vnd.github.v3+json",
                })
                with urllib.request.urlopen(req) as resp:
                    items = json.loads(resp.read().decode("utf-8"))
            except Exception as e:
                print(f"  ERROR listing {api_url}: {e}")
                continue

            # Recursively collect .tsx/.jsx files
            file_items = []
            dir_items = []
            for item in items:
                if item["type"] == "file" and (item["name"].endswith(".tsx") or item["name"].endswith(".jsx")):
                    file_items.append(item)
                elif item["type"] == "dir":
                    dir_items.append(item)

            # Fetch files in this directory
            for item in file_items:
                raw_url = item.get("download_url", "")
                if not raw_url:
                    continue
                try:
                    req = urllib.request.Request(raw_url, headers={"User-Agent": "shadcn-to-rails/1.0"})
                    with urllib.request.urlopen(req) as resp:
                        content = resp.read().decode("utf-8")
                    collected.append((item["name"], content, raw_url))
                    print(f"  Loaded: {item['name']}")
                except Exception as e:
                    print(f"  ERROR fetching {item['name']}: {e}")

            # Recurse into subdirectories
            for item in dir_items:
                sub_url = f"https://github.com/{user}/{repo}/tree/{branch}/{item['path']}"
                sub_data = fetch_github([sub_url])
                if sub_data:
                    for f in sub_data.get("files", []):
                        collected.append((Path(f["path"]).name, f["content"], f["path"]))

        # Already a raw URL
        elif "raw.githubusercontent.com" in url:
            print(f"  Fetching: {url}")
            try:
                req = urllib.request.Request(url, headers={"User-Agent": "shadcn-to-rails/1.0"})
                with urllib.request.urlopen(req) as resp:
                    content = resp.read().decode("utf-8")
                filename = url.split("/")[-1]
                collected.append((filename, content, url))
                print(f"  Loaded: {filename}")
            except Exception as e:
                print(f"  ERROR fetching {url}: {e}")
                continue
        else:
            print(f"  WARNING: Unsupported URL format: {url}")

    if not collected:
        print("  ERROR: No files fetched from GitHub.")
        return None

    # Sort: page.tsx/index.tsx first
    def sort_key(item):
        stem = Path(item[0]).stem.lower()
        return (0, item[0]) if stem in ("page", "index") else (1, item[0])
    collected.sort(key=sort_key)

    files = []
    for i, (filename, content, src) in enumerate(collected):
        stem = Path(filename).stem.lower()
        if stem in ("page", "index"):
            file_type = "registry:page"
        elif i == 0:
            file_type = "registry:page"
        else:
            file_type = "registry:component"
        files.append({"path": filename, "content": content, "type": file_type})

    return {
        "type": "registry:block",
        "description": f"GitHub: {', '.join(u for _, _, u in collected)}",
        "files": files,
    }


def load_local_files(file_paths):
    """Build registry-compatible data from local TSX files.

    Accepts a list of file paths. If a path is a directory, all .tsx/.jsx
    files within it (recursively) are included.

    Returns a dict matching the shadcn registry JSON structure:
      { "type": "registry:block", "files": [ { "path": ..., "content": ..., "type": ... } ] }
    """
    collected = []
    for fp in file_paths:
        p = Path(fp)
        if not p.exists():
            print(f"  WARNING: File not found: {fp}")
            continue
        if p.is_dir():
            # Collect all .tsx/.jsx files recursively
            for ext in ("**/*.tsx", "**/*.jsx"):
                collected.extend(sorted(p.glob(ext)))
        else:
            collected.append(p)

    if not collected:
        print("  ERROR: No .tsx/.jsx files found.")
        return None

    # Sort: page.tsx/index.tsx first, then alphabetically
    def sort_key(f):
        stem = f.stem.lower()
        if stem in ("page", "index"):
            return (0, str(f))
        return (1, str(f))
    collected.sort(key=sort_key)

    files = []
    for i, f in enumerate(collected):
        content = f.read_text(encoding="utf-8")
        # Heuristic: page.tsx/index.tsx → registry:page, others → registry:component
        stem = f.stem.lower()
        if stem in ("page", "index"):
            file_type = "registry:page"
        elif i == 0:
            # If no page.tsx found, treat first file as page
            file_type = "registry:page"
        else:
            file_type = "registry:component"
        files.append({
            "path": str(f),
            "content": content,
            "type": file_type,
        })
        print(f"  Loaded: {f} ({file_type})")

    return {
        "type": "registry:block",
        "description": f"Local files: {', '.join(str(f) for f in collected)}",
        "files": files,
    }


def load_existing_components():
    """Load existing components from components.json."""
    if COMPONENTS_JSON.exists():
        with open(COMPONENTS_JSON) as f:
            return json.load(f)
    return {}


def resolve_dependencies(data, existing):
    """Check which registry dependencies are missing."""
    deps = data.get("registryDependencies", [])
    missing = []
    for dep in deps:
        if dep not in existing:
            missing.append(dep)
    return missing


# ---------------------------------------------------------------------------
# Parser
# ---------------------------------------------------------------------------

def extract_imports(tsx_content):
    """Extract import statements and build icon/component maps."""
    icons = set()
    components = {}

    for match in re.finditer(
        r'import\s+\{([^}]+)\}\s+from\s+["\']([^"\']+)["\']', tsx_content
    ):
        names = [n.strip() for n in match.group(1).split(",") if n.strip()]
        source = match.group(2)

        if "lucide-react" in source:
            icons.update(names)
        else:
            for name in names:
                components[name] = source

    return {"icons": icons, "components": components}


def extract_props_defaults(tsx_content):
    """Extract React component props with their default values.

    Parses patterns like:
      const Comp = ({ title = "About Us", count = 5 }: Props) => { ... }
      function Comp({ title = "About Us" }: Props) { ... }

    Also extracts const default arrays/objects defined before the component.

    Returns a dict: { "title": '"About Us"', "count": "5", ... }
    """
    defaults = {}

    # Match destructured props with defaults in arrow function or regular function
    # Pattern: ({ prop1 = value1, prop2 = value2, ... }: Type) =>
    # or: function Name({ prop1 = value1, ... }: Type)
    prop_block_match = re.search(
        r'(?:const\s+\w+\s*=\s*\(\s*\{|function\s+\w+\s*\(\s*\{)(.*?)\}\s*(?::\s*\w+(?:\s*=\s*\{\})?)?\s*\)\s*(?:=>)?\s*\{',
        tsx_content, flags=re.DOTALL
    )
    if not prop_block_match:
        return defaults

    props_str = prop_block_match.group(1)

    # Parse simple scalar defaults: name = "string" or name = number
    for m in re.finditer(r'(\w+)\s*=\s*("(?:[^"\\]|\\.)*")', props_str):
        defaults[m.group(1)] = m.group(2)
    for m in re.finditer(r'(\w+)\s*=\s*(\d+(?:\.\d+)?)\s*[,}]', props_str):
        defaults[m.group(1)] = m.group(2)

    # Parse object defaults: name = { key: "val", ... }
    # Use bracket matching for nested objects
    for m in re.finditer(r'(\w+)\s*=\s*\{', props_str):
        prop_name = m.group(1)
        start = m.end() - 1  # position of opening {
        depth = 0
        pos = start
        while pos < len(props_str):
            ch = props_str[pos]
            if ch == '{':
                depth += 1
            elif ch == '}':
                depth -= 1
                if depth == 0:
                    obj_str = props_str[start:pos + 1]
                    defaults[prop_name] = obj_str.strip()
                    break
            elif ch in ('"', "'"):
                quote = ch
                pos += 1
                while pos < len(props_str) and props_str[pos] != quote:
                    if props_str[pos] == '\\':
                        pos += 1
                    pos += 1
            pos += 1

    # Parse array defaults: name = [ { ... }, ... ]
    # Use bracket matching for nested arrays
    for m in re.finditer(r'(\w+)\s*=\s*\[', props_str):
        prop_name = m.group(1)
        if prop_name in defaults:
            continue
        start = m.end() - 1  # position of opening [
        depth = 0
        pos = start
        while pos < len(props_str):
            ch = props_str[pos]
            if ch == '[':
                depth += 1
            elif ch == ']':
                depth -= 1
                if depth == 0:
                    arr_str = props_str[start:pos + 1]
                    defaults[prop_name] = arr_str.strip()
                    break
            elif ch in ('"', "'"):
                quote = ch
                pos += 1
                while pos < len(props_str) and props_str[pos] != quote:
                    if props_str[pos] == '\\':
                        pos += 1
                    pos += 1
            pos += 1

    # Parse defaults referencing const variables (e.g., companies = defaultCompanies)
    for m in re.finditer(r'(\w+)\s*=\s*([a-z]\w*)\s*[,}]', props_str):
        prop_name = m.group(1)
        var_name = m.group(2)
        if prop_name not in defaults:
            # Look up the const definition
            const_match = re.search(
                rf'const\s+{re.escape(var_name)}\s*(?::\s*[^=]+)?\s*=\s*(\[.*?\]);',
                tsx_content, flags=re.DOTALL
            )
            if const_match:
                defaults[prop_name] = const_match.group(1).strip()

    return defaults


def extract_jsx_body(tsx_content):
    """Extract the JSX return body from a TSX component."""
    # Try to find: return ( ... )
    # Use a bracket-matching approach
    match = re.search(r'\breturn\s*\(', tsx_content)
    if not match:
        # Try: return <...
        match = re.search(r'\breturn\s*(<)', tsx_content)
        if not match:
            return tsx_content

    start = match.end()
    if tsx_content[start - 1] == '(':
        # Find matching closing paren
        depth = 1
        pos = start
        while pos < len(tsx_content) and depth > 0:
            ch = tsx_content[pos]
            if ch == '(':
                depth += 1
            elif ch == ')':
                depth -= 1
            elif ch in ('"', "'", '`'):
                # Skip strings
                quote = ch
                pos += 1
                while pos < len(tsx_content) and tsx_content[pos] != quote:
                    if tsx_content[pos] == '\\':
                        pos += 1
                    pos += 1
            pos += 1
        return tsx_content[start:pos - 1].strip()
    else:
        # return <tag>...</tag> — find the end
        return tsx_content[start - 1:].strip()


# ---------------------------------------------------------------------------
# Transformer
# ---------------------------------------------------------------------------

def _parse_js_object(obj_str):
    """Parse a simple JS object literal into a Python dict.

    Handles: { key: "value", key2: "value2" }
    Returns dict of string keys → string values.
    """
    result = {}
    # Match key: "value" or key: 'value'
    for m in re.finditer(r'(\w+)\s*:\s*("(?:[^"\\]|\\.)*"|\'(?:[^\'\\]|\\.)*\')', obj_str):
        key = m.group(1)
        val = m.group(2).strip('"').strip("'")
        result[key] = val
    return result


def _parse_js_array(arr_str):
    """Parse a simple JS array of objects into a Python list of dicts.

    Handles: [ { key: "val" }, { key: "val2" } ]
    """
    result = []
    # Find each object in the array
    depth = 0
    start = None
    for i, ch in enumerate(arr_str):
        if ch == '{':
            if depth == 0:
                start = i
            depth += 1
        elif ch == '}':
            depth -= 1
            if depth == 0 and start is not None:
                result.append(_parse_js_object(arr_str[start:i + 1]))
                start = None
    return result


def _build_array_locals(props_defaults):
    """Build ERB local variable assignments for array props.

    Returns a string of <% array = [...] %> to prepend to ERB output.
    This is kept separate from the JSX transform to avoid ERB tag corruption.
    """
    blocks = []
    for prop_name, default_val in props_defaults.items():
        if not default_val.lstrip().startswith('['):
            continue
        items = _parse_js_array(default_val)
        if not items:
            continue
        ruby_items = []
        for item in items:
            pairs = ", ".join(f'{k}: "{v}"' for k, v in item.items())
            ruby_items.append("  { " + pairs + " }")
        blocks.append(f"<% {prop_name} = [\n" + ",\n".join(ruby_items) + "\n] %>")
    return "\n".join(blocks)


def _inline_props_defaults(jsx, props_defaults):
    """Replace simple prop references with their default values.

    For string props: {title} → default string value directly
    For object props: {obj.key} → default value from parsed object
    """
    result = jsx

    for prop_name, default_val in props_defaults.items():
        if default_val.startswith('"') and default_val.endswith('"'):
            # Simple string prop: replace {propName} with the default value
            plain_val = default_val.strip('"')
            result = re.sub(
                r'\{' + re.escape(prop_name) + r'\}',
                plain_val,
                result
            )
            # Also in ERB context: <%= propName %> (if already converted)
            result = re.sub(
                r'<%=\s*' + re.escape(prop_name) + r'\s*%>',
                plain_val,
                result
            )
        elif default_val.startswith('{'):
            # Object prop: parse and replace {obj.key} references
            obj = _parse_js_object(default_val)
            for key, val in obj.items():
                # In attribute context: attr={obj.key} → attr="value"
                result = re.sub(
                    r'(\w+)=\{' + re.escape(prop_name) + r'\.' + re.escape(key) + r'\}',
                    r'\1="' + val.replace('\\', '\\\\') + '"',
                    result
                )
                # In text context: {obj.key} → value
                result = re.sub(
                    r'\{' + re.escape(prop_name) + r'\.' + re.escape(key) + r'\}',
                    val,
                    result
                )
                # Already-converted ERB: <%= obj.key %> → value
                result = re.sub(
                    r'<%=\s*' + re.escape(prop_name) + r'\.' + re.escape(key) + r'\s*%>',
                    val,
                    result
                )
        elif default_val.lstrip().startswith('['):
            # Array prop: handled by _build_array_locals() after transform
            pass
        else:
            # Numeric or other simple value
            result = re.sub(
                r'\{' + re.escape(prop_name) + r'\}',
                str(default_val),
                result
            )

    return result


def _remove_conditional_rendering(jsx):
    """Remove JSX conditional rendering patterns that produce invalid ERB.

    Handles patterns like:
      {prop && (<html>...</html>)}  → <html>...</html>
      {prop && <html>...</html>}    → <html>...</html>
      {condition ? (<a>) : (<b>)}   → <a>  (keeps truthy branch)

    These are the #1 source of broken ERB output from JSX conversion.
    """
    result = jsx

    # Pattern 1: {expr && (<html>...</html>)}
    # Use bracket matching for nested parens
    # Matches both simple identifiers and complex expressions (e.g., idx < arr.length - 1)
    pattern = r'\{[^{}]*?\s*&&\s*\('
    iterations = 0
    while iterations < 50:
        m = re.search(pattern, result)
        if not m:
            break
        iterations += 1
        start_brace = m.start()
        paren_start = m.end() - 1
        depth = 0
        pos = paren_start
        while pos < len(result):
            ch = result[pos]
            if ch == '(':
                depth += 1
            elif ch == ')':
                depth -= 1
                if depth == 0:
                    # Find closing }
                    rest = result[pos + 1:].lstrip()
                    if rest.startswith('}'):
                        end = pos + 1 + (len(result[pos + 1:]) - len(rest)) + 1
                        body = result[paren_start + 1:pos].strip()
                        result = result[:start_brace] + body + result[end:]
                    break
            pos += 1
        else:
            break

    # Pattern 2: {identifier && <tag>...</tag>} (without parens)
    result = re.sub(
        r'\{(\w+(?:\.\w+)*)\s*&&\s*(<[a-z][^}]*>(?:[^{}]*?)</[a-z]\w*>)\s*\}',
        r'\2',
        result, flags=re.DOTALL
    )

    # Pattern 2b: {complex_expr && <tag>...</tag>} — expressions with operators
    result = re.sub(
        r'\{[^{}]*?\s*&&\s*(<[a-zA-Z][^}]*>(?:[^{}]*?)</[a-zA-Z]\w*>)\s*\}',
        r'\1',
        result, flags=re.DOTALL
    )

    # Pattern 3: {identifier && <SelfClosing />} (without parens)
    result = re.sub(
        r'\{(\w+(?:\.\w+)*)\s*&&\s*(<[a-zA-Z][^}]*?/>)\s*\}',
        r'\2',
        result
    )

    # Pattern 3b: {complex_expr && <SelfClosing />}
    result = re.sub(
        r'\{[^{}]*?\s*&&\s*(<[a-zA-Z][^}]*?/>)\s*\}',
        r'\1',
        result
    )

    # Pattern 3c: {complex_expr && <%= ERB_helper %>}
    result = re.sub(
        r'\{[^{}]*?\s*&&\s*(<%=\s*[^%]+%>)\s*\}',
        r'\1',
        result
    )

    # Pattern 4: Simple ternary {cond ? <a> : <b>} → keep truthy branch
    result = re.sub(
        r'\{[^{}]+\?\s*(<[^{}]+?>(?:[^{}]*?)<\/[^{}]+?>)\s*:\s*(?:<[^{}]+?>(?:[^{}]*?)<\/[^{}]+?>|null|"")\s*\}',
        r'\1',
        result, flags=re.DOTALL
    )

    # Pattern 5: {cond ? "text" : "other"} → "text"
    result = re.sub(
        r'\{[^{}]+\?\s*"([^"]*)"\s*:\s*"[^"]*"\s*\}',
        r'\1',
        result
    )

    return result


def _remove_react_fragments(jsx):
    """Remove React.Fragment and Fragment wrappers, keeping children.

    <React.Fragment>...</React.Fragment> → ...
    <Fragment>...</Fragment> → ...
    <>...</> → ...
    """
    result = jsx
    # Named fragments
    result = re.sub(r'<React\.Fragment\s*>', '', result)
    result = re.sub(r'</React\.Fragment>', '', result)
    result = re.sub(r'<Fragment\s*>', '', result)
    result = re.sub(r'</Fragment>', '', result)
    # Shorthand fragments
    result = re.sub(r'<>', '', result)
    result = re.sub(r'</>', '', result)
    return result


def _convert_inline_styles(jsx):
    """Convert JSX inline styles to HTML style attributes.

    style={{ transform: "rotate(45deg)", opacity: 0.5 }}
    → style="transform: rotate(45deg); opacity: 0.5"

    style={{ ...obj, key: "val" }}
    → style="key: val"  (drop spread)
    """
    result = jsx

    def replace_style(m):
        inner = m.group(1).strip()
        # Remove spread operators
        inner = re.sub(r'\.\.\.(\w+),?\s*', '', inner)
        # Parse key: "value" or key: number pairs
        pairs = []
        # camelCase → kebab-case for CSS properties
        for pm in re.finditer(r'(\w+)\s*:\s*("([^"]*)"|\'([^\']*)\'|([^,}\s]+))', inner):
            prop = pm.group(1)
            val = pm.group(3) or pm.group(4) or pm.group(5) or ""
            # Convert camelCase to kebab-case
            css_prop = re.sub(r'([a-z])([A-Z])', lambda x: x.group(1) + '-' + x.group(2).lower(), prop)
            pairs.append(f'{css_prop}: {val}')
        if pairs:
            return f'style="{"; ".join(pairs)}"'
        return ''

    # Match style={{ ... }} (double braces)
    result = re.sub(r'style=\{\{([^}]*(?:\{[^}]*\}[^}]*)*)\}\}', replace_style, result)
    return result


def _convert_template_literals(jsx):
    """Convert JSX template literals to ERB string interpolation.

    {`item-${index}`}  → item-<%= index %>
    class={`foo ${bar}`} → class="foo <%= bar %>"
    """
    result = jsx

    # In attribute context: attr={`...${expr}...`} → attr="...<%= expr %>..."
    def replace_attr_template(m):
        attr = m.group(1)
        template = m.group(2)
        converted = re.sub(r'\$\{([^}]+)\}', r'<%= \1 %>', template)
        return f'{attr}="{converted}"'
    result = re.sub(r'(\w+)=\{`([^`]*)`\}', replace_attr_template, result)

    # In text context: {`...${expr}...`} → ...<%= expr %>...
    def replace_text_template(m):
        template = m.group(1)
        converted = re.sub(r'\$\{([^}]+)\}', r'<%= \1 %>', template)
        return converted
    result = re.sub(r'\{`([^`]*)`\}', replace_text_template, result)

    return result


def _convert_dangerous_inner_html(jsx):
    """Convert dangerouslySetInnerHTML to raw ERB output.

    <div dangerouslySetInnerHTML={{ __html: item.content }} />
    → <div><%= item[:content].html_safe %></div>

    <div dangerouslySetInnerHTML={{ __html: "some html" }} />
    → <div>some html</div>
    """
    result = jsx

    # Self-closing with dangerouslySetInnerHTML
    def replace_dangerous_self(m):
        tag = m.group(1)
        attrs = m.group(2) or ""
        html_expr = m.group(3).strip()
        # Remove dangerouslySetInnerHTML from attrs
        clean_attrs = re.sub(r'\s*dangerouslySetInnerHTML=\{\{[^}]*\}\}', '', attrs).strip()
        # Determine the inner HTML expression
        if html_expr.startswith('"') or html_expr.startswith("'"):
            inner = html_expr.strip('"').strip("'")
        else:
            # Convert JS dot access to Ruby hash access
            inner_ruby = re.sub(r'(\w+)\.(\w+)', r'<%= \1[:\2].html_safe %>', html_expr)
            if '<%=' not in inner_ruby:
                inner_ruby = f'<%= {html_expr}.html_safe %>'
            inner = inner_ruby
        attr_str = f' {clean_attrs}' if clean_attrs else ''
        return f'<{tag}{attr_str}>{inner}</{tag}>'

    result = re.sub(
        r'<(\w+)(\s[^>]*)?\s+dangerouslySetInnerHTML=\{\{\s*__html:\s*([^}]+)\}\}\s*/>',
        replace_dangerous_self, result
    )

    # Block element with dangerouslySetInnerHTML (opening tag)
    def replace_dangerous_block(m):
        tag = m.group(1)
        attrs = m.group(2) or ""
        html_expr = m.group(3).strip()
        clean_attrs = re.sub(r'\s*dangerouslySetInnerHTML=\{\{[^}]*\}\}', '', attrs).strip()
        if html_expr.startswith('"') or html_expr.startswith("'"):
            inner = html_expr.strip('"').strip("'")
        else:
            inner_ruby = re.sub(r'(\w+)\.(\w+)', r'<%= \1[:\2].html_safe %>', html_expr)
            if '<%=' not in inner_ruby:
                inner_ruby = f'<%= {html_expr}.html_safe %>'
            inner = inner_ruby
        attr_str = f' {clean_attrs}' if clean_attrs else ''
        return f'<{tag}{attr_str}>{inner}</{tag}>'

    result = re.sub(
        r'<(\w+)(\s[^>]*)?\s+dangerouslySetInnerHTML=\{\{\s*__html:\s*([^}]+)\}\}\s*>(.*?)</\1>',
        replace_dangerous_block, result, flags=re.DOTALL
    )

    return result


def _fix_unquoted_attributes(jsx):
    """Fix unquoted HTML attribute values.

    src=https://example.com → src="https://example.com"
    alt=Some text → alt="Some text"
    """
    result = jsx

    # Fix src=http... without quotes
    result = re.sub(r'(src|href)=(https?://[^\s>"\'"]+)', r'\1="\2"', result)

    # Fix common attributes with unquoted values containing /
    result = re.sub(r'(alt|title|aria-label)=([^\s>"\'][^\s>]*)', lambda m: f'{m.group(1)}="{m.group(2)}"' if not m.group(2).startswith('"') else m.group(0), result)

    return result


def _js_dot_to_ruby_hash(expr):
    """Convert JS dot property access to Ruby hash access.

    plan.features → plan[:features]
    item.sub.prop → item[:sub][:prop]
    simple → simple (no change for single identifiers)
    """
    parts = expr.split('.')
    if len(parts) <= 1:
        return expr
    result = parts[0]
    for part in parts[1:]:
        result += f'[:{part}]'
    return result


def _convert_map_to_each(jsx):
    """Convert JSX .map() iterations to ERB each loops.

    {items.map((item, idx) => (
      <div key={...}>...</div>
    ))}
    →
    <% items.each do |item| %>
      <div>...</div>
    <% end %>
    """
    result = jsx

    def replace_map(m):
        full = m.group(0)
        array_name = m.group(1)
        item_var = m.group(2)
        # idx_var = m.group(3)  # optional index var, usually not needed in ERB
        body = m.group(4)

        # Remove key={...} attributes (React-specific)
        body = re.sub(r'\s+key=\{[^}]*\}', '', body)

        # Replace {item.prop} → <%= item[:prop] %> within the body
        def replace_item_prop(pm):
            prop = pm.group(1)
            return f'<%= {item_var}[:{prop}] %>'
        body = re.sub(rf'\{{{re.escape(item_var)}\.(\w+)\}}', replace_item_prop, body)

        # Replace item.prop in attribute values: attr={item.prop} → attr="<%= item[:prop] %>"
        def replace_attr_item_prop(pm):
            attr = pm.group(1)
            prop = pm.group(2)
            return f'{attr}="<%= {item_var}[:{prop}] %>"'
        body = re.sub(rf'(\w+)=\{{{re.escape(item_var)}\.(\w+)\}}', replace_attr_item_prop, body)

        return f'<% {array_name}.each do |{item_var}| %>\n{body.strip()}\n<% end %>'

    # Match: {arrayName.map((item, idx?) => ( ... ))}
    # Also matches nested: {plan.features.map((feature) => (...))}
    # Use bracket matching for the outer ( ... )
    pattern = r'\{([\w.]+)\.map\(\((\w+)(?:,\s*(\w+))?\)\s*=>\s*\('
    for m in re.finditer(pattern, result):
        start = m.end() - 1  # position of opening (
        depth = 0
        pos = start
        while pos < len(result):
            ch = result[pos]
            if ch == '(':
                depth += 1
            elif ch == ')':
                depth -= 1
                if depth == 0:
                    # Find closing ))} — skip whitespace after )
                    end = pos + 1
                    # Skip )} at the end
                    rest = result[end:].lstrip()
                    if rest.startswith(')}'):
                        end = end + (len(result[end:]) - len(result[end:].lstrip())) + 2
                    body = result[start + 1:pos]

                    # Build replacement
                    array_name = _js_dot_to_ruby_hash(m.group(1))
                    item_var = m.group(2)
                    body_clean = body

                    # Remove key={...}
                    body_clean = re.sub(r'\s+key=\{[^}]*\}', '', body_clean)

                    # Replace attr={item.prop} → attr="<%= item[:prop] %>" (MUST run before text replacement)
                    def replace_attr_inner(pm, _item_var=item_var):
                        attr = pm.group(1)
                        prop = pm.group(2)
                        return f'{attr}="<%= {_item_var}[:{prop}] %>"'
                    body_clean = re.sub(rf'(\w+)=\{{{re.escape(item_var)}\.(\w+)\}}', replace_attr_inner, body_clean)

                    # Replace {item.prop} → <%= item[:prop] %> (text context)
                    def replace_item_prop_inner(pm, _item_var=item_var):
                        prop = pm.group(1)
                        return f'<%= {_item_var}[:{prop}] %>'
                    body_clean = re.sub(rf'\{{{re.escape(item_var)}\.(\w+)\}}', replace_item_prop_inner, body_clean)

                    replacement = f'<% {array_name}.each do |{item_var}| %>\n{body_clean.strip()}\n<% end %>'
                    result = result[:m.start()] + replacement + result[end:]
                    break
            elif ch in ('"', "'", '`'):
                quote = ch
                pos += 1
                while pos < len(result) and result[pos] != quote:
                    if result[pos] == '\\':
                        pos += 1
                    pos += 1
            pos += 1
        break  # Only replace first match, then re-scan (to handle shifted positions)

    # Pattern 2: {arr.map((item) => { return (...) })}
    pattern2 = r'\{([\w.]+)\.map\(\((\w+)(?:,\s*(\w+))?\)\s*=>\s*\{'
    for m in re.finditer(pattern2, result):
        start = m.end() - 1  # position of opening {
        depth = 0
        pos = start
        while pos < len(result):
            ch = result[pos]
            if ch == '{':
                depth += 1
            elif ch == '}':
                depth -= 1
                if depth == 0:
                    end = pos + 1
                    rest = result[end:].lstrip()
                    if rest.startswith(')}'):
                        end = end + (len(result[end:]) - len(result[end:].lstrip())) + 2
                    body = result[start + 1:pos]
                    # Extract return (...) body
                    return_match = re.search(r'return\s*\((.*)\)', body, flags=re.DOTALL)
                    if return_match:
                        body = return_match.group(1)
                    else:
                        return_match2 = re.search(r'return\s+(.*)', body, flags=re.DOTALL)
                        if return_match2:
                            body = return_match2.group(1)

                    array_name = _js_dot_to_ruby_hash(m.group(1))
                    item_var = m.group(2)
                    body_clean = re.sub(r'\s+key=\{[^}]*\}', '', body)
                    def replace_attr_inner2(pm, _item_var=item_var):
                        attr = pm.group(1)
                        prop = pm.group(2)
                        return f'{attr}="<%= {_item_var}[:{prop}] %>"'
                    body_clean = re.sub(rf'(\w+)=\{{{re.escape(item_var)}\.(\w+)\}}', replace_attr_inner2, body_clean)
                    def replace_item_prop_inner2(pm, _item_var=item_var):
                        prop = pm.group(1)
                        return f'<%= {_item_var}[:{prop}] %>'
                    body_clean = re.sub(rf'\{{{re.escape(item_var)}\.(\w+)\}}', replace_item_prop_inner2, body_clean)

                    replacement = f'<% {array_name}.each do |{item_var}| %>\n{body_clean.strip()}\n<% end %>'
                    result = result[:m.start()] + replacement + result[end:]
                    break
            elif ch in ('"', "'", '`'):
                quote = ch
                pos += 1
                while pos < len(result) and result[pos] != quote:
                    if result[pos] == '\\':
                        pos += 1
                    pos += 1
            pos += 1
        break

    # Pattern 3: {arr.map((item) => <SingleLine />)} — arrow returning JSX directly without parens
    def replace_map_single_line(m):
        array_name = _js_dot_to_ruby_hash(m.group(1))
        item_var = m.group(2)
        body = m.group(3)
        body = re.sub(r'\s+key=\{[^}]*\}', '', body)
        body = re.sub(rf'(\w+)=\{{{re.escape(item_var)}\.(\w+)\}}',
                       lambda pm: f'{pm.group(1)}="<%= {item_var}[:{pm.group(2)}] %>"', body)
        body = re.sub(rf'\{{{re.escape(item_var)}\.(\w+)\}}',
                       lambda pm: f'<%= {item_var}[:{pm.group(1)}] %>', body)
        return f'<% {array_name}.each do |{item_var}| %>\n{body.strip()}\n<% end %>'

    result = re.sub(
        r'\{([\w.]+)\.map\(\((\w+)\)\s*=>\s*(<[A-Za-z][^)]*?/>)\s*\)\}',
        replace_map_single_line, result
    )

    # Repeat for additional .map() calls (recursive approach)
    # Guard against infinite recursion: only recurse if we actually changed something
    if re.search(r'\{[\w.]+\.map\(', result) and result != jsx:
        result = _convert_map_to_each(result)

    return result


def _convert_object_attr_access(jsx, props_defaults):
    """Convert remaining object property access in HTML attributes.

    attr={obj.prop} → attr="resolved_value" (if default known)
    attr={obj.prop} → attr="<%= obj[:prop] %>" (if no default)
    """
    result = jsx

    def replace_obj_attr(m):
        attr = m.group(1)
        obj_name = m.group(2)
        prop_name = m.group(3)

        # Try to resolve from props_defaults
        if obj_name in props_defaults:
            default_val = props_defaults[obj_name]
            if default_val.startswith('{'):
                obj = _parse_js_object(default_val)
                if prop_name in obj:
                    return f'{attr}="{obj[prop_name]}"'

        return f'{attr}="<%= {obj_name}[:{prop_name}] %>"'

    result = re.sub(r'(\w+)=\{(\w+)\.(\w+)\}', replace_obj_attr, result)
    return result


def transform_jsx_to_erb(jsx, icons=None, partial_prefix="", props_defaults=None):
    """Transform JSX to ERB markup.

    partial_prefix: e.g. "blocks/login_03/" for block sub-component paths
    props_defaults: dict of prop name → default value string from React component
    """
    if icons is None:
        icons = set()
    if props_defaults is None:
        props_defaults = {}

    result = jsx

    # 1. Remove React-specific imports and exports
    result = re.sub(r'^\s*import\s+.*$', '', result, flags=re.MULTILINE)
    result = re.sub(r'^\s*export\s+(default\s+)?', '', result, flags=re.MULTILINE)

    # 2. Replace {" "} with a space
    result = result.replace('{" "}', ' ')

    # 3. Replace &apos; → '
    result = result.replace("&apos;", "'")

    # 4. Replace JSX comments {/* ... */}
    result = re.sub(r'\{/\*.*?\*/\}', lambda m: f'<%# {m.group(0)[3:-3].strip()} %>', result, flags=re.DOTALL)

    # 4a-1. Remove React.Fragment wrappers (before any other transform)
    result = _remove_react_fragments(result)

    # 4a-2. Convert dangerouslySetInnerHTML (before conditional rendering removal)
    result = _convert_dangerous_inner_html(result)

    # 4a-3. Convert JSX inline styles: style={{...}} → style="..."
    result = _convert_inline_styles(result)

    # 4a-4. Convert template literals: {`text-${var}`} → text-<%= var %>
    result = _convert_template_literals(result)

    # 4b. Inline prop defaults and convert .map() loops
    if props_defaults:
        result = _inline_props_defaults(result, props_defaults)

    # 4c. Convert .map() iterations to ERB each loops
    result = _convert_map_to_each(result)

    # 4d. Convert object property access in attributes: attr={obj.prop} → attr="value" or attr="<%= obj[:prop] %>"
    result = _convert_object_attr_access(result, props_defaults)

    # 4e. Remove JSX conditional rendering: {prop && (...)} → content
    result = _remove_conditional_rendering(result)

    # 4f. Fix unquoted HTML attributes: src=https://... → src="https://..."
    result = _fix_unquoted_attributes(result)

    # 5. Handle Lucide icons - self-closing: <IconName className="..." />
    def replace_icon(m):
        icon_name = m.group(1)
        attrs_str = m.group(2) or ""
        # Extract className if any
        cls_match = re.search(r'className="([^"]*)"', attrs_str)
        icon_class = cls_match.group(1) if cls_match else "size-4"

        if icon_name in LUCIDE_ICONS:
            svg = LUCIDE_ICONS[icon_name]
            # Update the class
            svg = re.sub(r'class="[^"]*"', f'class="{icon_class}"', svg)
            return svg
        else:
            return f'<!-- TODO: Lucide icon "{icon_name}" class="{icon_class}" -->'

    for icon_name in icons:
        # Self-closing icon tags
        pattern = rf'<({re.escape(icon_name)})\s*((?:[^>]*?))\s*/>'
        result = re.sub(pattern, replace_icon, result)

    # 6. Handle known components (COMPONENT_MAP)
    result = transform_known_components(result)

    # 7. Handle sub-components (SUB_COMPONENT_MAP)
    result = transform_sub_components(result)

    # 8. Transform JSX attributes to HTML
    result = transform_attributes(result)

    # 9. Handle remaining JSX expressions
    result = transform_jsx_expressions(result)

    # 10. Handle unknown PascalCase component tags as partial renders
    def replace_unknown_component_self_closing(m):
        comp = m.group(1)
        attrs = m.group(2) or ""
        partial_name = camel_to_snake(comp).replace("-", "_")
        return f'<%= render "{partial_prefix}{partial_name}" %>'

    def replace_unknown_component_block(m):
        comp = m.group(1)
        attrs = m.group(2) or ""
        children = m.group(3) or ""
        partial_name = camel_to_snake(comp).replace("-", "_")
        return f'<%= render "{partial_prefix}{partial_name}" do %>\n{children.strip()}\n<% end %>'

    # Self-closing unknown components
    result = re.sub(r'<([A-Z][a-zA-Z0-9]+)\s*((?:[^>]*?))\s*/>', replace_unknown_component_self_closing, result)
    # Block unknown components
    result = re.sub(r'<([A-Z][a-zA-Z0-9]+)(\s[^>]*)?>(((?!<\1[\s>]).){0,20000}?)</\1>', replace_unknown_component_block, result, flags=re.DOTALL)

    # 10. Clean up self-closing HTML tags for non-void elements
    void_elements = {'area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input',
                     'link', 'meta', 'param', 'source', 'track', 'wbr'}
    def fix_self_closing(m):
        tag = m.group(1)
        attrs = m.group(2) or ""
        if tag.lower() in void_elements:
            return f'<{tag}{attrs} />'
        return f'<{tag}{attrs}></{tag}>'
    result = re.sub(r'<([a-z][a-zA-Z0-9]*)((?:\s+[^>]*?)?)\s*/>', fix_self_closing, result)

    # 11. Add size-4 class to inline SVGs that have no class attribute
    def add_svg_size(m):
        attrs = m.group(1)
        if 'class=' not in attrs:
            return f'<svg{attrs} class="size-4">'
        return m.group(0)
    result = re.sub(r'<svg([^>]*)>', add_svg_size, result)

    # 12. Convert div with text-balance to p tag for proper text wrapping
    # Only match div tags whose content has no nested divs (leaf-level text containers)
    def convert_text_balance_div(m):
        attrs = m.group(1)
        content = m.group(2)
        # Only convert if content has no nested div tags
        if '<div' not in content:
            return f'<p{attrs}>{content}</p>'
        return m.group(0)
    result = re.sub(r'<div(\s[^>]*text-balance[^>]*)>(.*?)</div>', convert_text_balance_div, result, flags=re.DOTALL)

    # 13. Add min-w-0 to top-level flex containers using tw() to prevent overflow
    result = re.sub(
        r'class="<%= tw\("(flex\s)',
        r'class="<%= tw("min-w-0 \1',
        result
    )

    # 14. Clean up excessive blank lines
    result = re.sub(r'\n{3,}', '\n\n', result)

    # 15. Prepend array local variable assignments (after all transforms to avoid ERB corruption)
    if props_defaults:
        array_locals = _build_array_locals(props_defaults)
        if array_locals:
            result = array_locals + "\n" + result

    return result.strip()


def transform_known_components(jsx):
    """Replace known React components with Rails helper calls."""
    result = jsx

    for comp_name, config in COMPONENT_MAP.items():
        helper = config["helper"]
        is_block = config.get("block", False)
        is_self_closing = config.get("self_closing", False)
        text_arg = config.get("text_arg", False)

        def _apply_inject_class(props, _config):
            """Merge inject_class into the class prop."""
            inject = _config.get("inject_class")
            if inject:
                if "class" in props:
                    # Merge: strip quotes, combine, re-quote
                    existing = props["class"].strip('"')
                    props["class"] = f'"{inject} {existing}"'
                else:
                    props["class"] = f'"{inject}"'

        # Self-closing: <Component prop="val" />
        def replace_self_closing(m, _helper=helper, _config=config):
            attrs = m.group(1) or ""
            props = parse_jsx_attrs(attrs, _config.get("props", {}))
            _apply_inject_class(props, _config)
            # Handle required_props mapping (e.g. name: derived from id attr)
            required = _config.get("required_props", {})
            for ruby_key, source in required.items():
                if ruby_key not in props:
                    if source == "text_content":
                        props[ruby_key] = '""'
                    elif source in ("id", "htmlFor"):
                        # Try to get from existing parsed props or raw attrs
                        val = _extract_attr_value(attrs, source)
                        if val:
                            props[ruby_key] = f'"{val}"'
                        else:
                            props[ruby_key] = '""'
            props_str = format_ruby_props(props)
            return f'<%= {_helper}({props_str}) %>'

        result = re.sub(
            rf'<{re.escape(comp_name)}\s*((?:[^>]*?))\s*/>',
            replace_self_closing, result
        )

        # keyword_only: match block tags but render as keyword-only helper call (no block, no positional)
        keyword_only = config.get("keyword_only", False)
        if keyword_only:
            def replace_keyword_only_block(m, _helper=helper, _config=config):
                attrs = m.group(1) or ""
                children = m.group(2) or ""
                props = parse_jsx_attrs(attrs, _config.get("props", {}))
                required = _config.get("required_props", {})
                for ruby_key, source in required.items():
                    if ruby_key not in props:
                        if source == "text_content":
                            clean = re.sub(r'<[^>]*>', '', children).strip()
                            clean = re.sub(r'\{[^}]*\}', '', clean).strip()
                            props[ruby_key] = f'"{clean}"' if clean else '""'
                        elif source in ("id", "htmlFor"):
                            val = _extract_attr_value(attrs, source)
                            if val:
                                props[ruby_key] = f'"{val}"'
                props_str = format_ruby_props(props)
                return f'<%= {_helper}({props_str}) %>'

            pattern = rf'<{re.escape(comp_name)}(\s[^>]*)?>(((?!<{re.escape(comp_name)}[\s>]).){{0,20000}}?)</{re.escape(comp_name)}>'
            result = re.sub(pattern, replace_keyword_only_block, result, flags=re.DOTALL)

        if is_block or text_arg:
            # Opening + closing tags with content: <Component props>...children...</Component>
            def replace_block(m, _helper=helper, _config=config, _text_arg=text_arg):
                attrs = m.group(1) or ""
                children = m.group(2) or ""
                props = parse_jsx_attrs(attrs, _config.get("props", {}))
                _apply_inject_class(props, _config)
                # Apply default_props if not already set
                for k, v in _config.get("default_props", {}).items():
                    if k not in props:
                        props[k] = v
                children = children.strip()

                # Handle required_props
                required = _config.get("required_props", {})
                for ruby_key, source in required.items():
                    if ruby_key not in props:
                        if source == "text_content":
                            # Use children text as value
                            clean = re.sub(r'<[^>]*>', '', children).strip()
                            clean = re.sub(r'\{[^}]*\}', '', clean).strip()
                            props[ruby_key] = f'"{clean}"' if clean else '""'
                        elif source in ("id", "htmlFor"):
                            val = _extract_attr_value(attrs, source)
                            if val:
                                props[ruby_key] = f'"{val}"'

                props_str = format_ruby_props(props)

                # If children is simple text and component accepts text_arg
                if _text_arg and not re.search(r'<[a-zA-Z]', children):
                    clean_text = children.strip()
                    clean_text = re.sub(r'\{[^}]*\}', '', clean_text).strip()
                    if clean_text:
                        text_escaped = clean_text.replace('"', '\\"')
                        if props_str:
                            return f'<%= {_helper}("{text_escaped}", {props_str}) %>'
                        return f'<%= {_helper}("{text_escaped}") %>'

                if props_str:
                    return f'<%= {_helper}({props_str}) do %>\n{children}\n<% end %>'
                return f'<%= {_helper} do %>\n{children}\n<% end %>'

            # Match opening/closing tags (non-greedy, handling nesting approximately)
            pattern = rf'<{re.escape(comp_name)}(\s[^>]*)?>(((?!<{re.escape(comp_name)}[\s>]).){{0,20000}}?)</{re.escape(comp_name)}>'
            result = re.sub(pattern, replace_block, result, flags=re.DOTALL)

    return result


def transform_sub_components(jsx):
    """Replace sub-components with HTML tags + Tailwind classes."""
    result = jsx

    # Sort by length (longest first) to handle e.g. CardHeader before Card
    sorted_subs = sorted(SUB_COMPONENT_MAP.keys(), key=len, reverse=True)

    for comp_name in sorted_subs:
        config = SUB_COMPONENT_MAP[comp_name]
        tag = config["tag"]
        default_class = config.get("class", "")
        unwrap = config.get("unwrap", False)

        # Self-closing: <SubComponent ... />
        def replace_self_closing_sub(m, _tag=tag, _default_class=default_class, _unwrap=unwrap):
            attrs = m.group(1) or ""
            if _unwrap:
                return ""
            cls = extract_classname(attrs)
            merged = merge_classes(_default_class, cls)
            other_attrs = remove_classname_attr(attrs)
            if merged:
                return f'<{_tag} class="{merged}"{other_attrs} />' if _tag in ('hr', 'br', 'img', 'input') else f'<{_tag} class="{merged}"{other_attrs}></{_tag}>'
            return f'<{_tag}{other_attrs} />' if _tag in ('hr', 'br', 'img', 'input') else f'<{_tag}{other_attrs}></{_tag}>'

        result = re.sub(
            rf'<{re.escape(comp_name)}\s*((?:[^>]*?))\s*/>',
            replace_self_closing_sub, result
        )

        # Opening/closing: <SubComponent ...>children</SubComponent>
        def replace_block_sub(m, _tag=tag, _default_class=default_class, _unwrap=unwrap):
            attrs = m.group(1) or ""
            children = m.group(2) or ""
            if _unwrap:
                return children.strip()
            cls = extract_classname(attrs)
            merged = merge_classes(_default_class, cls)
            other_attrs = remove_classname_attr(attrs)
            if merged:
                return f'<{_tag} class="{merged}"{other_attrs}>{children}</{_tag}>'
            return f'<{_tag}{other_attrs}>{children}</{_tag}>'

        pattern = rf'<{re.escape(comp_name)}(\s[^>]*)?>(((?!<{re.escape(comp_name)}[\s>]).){{0,20000}}?)</{re.escape(comp_name)}>'
        result = re.sub(pattern, replace_block_sub, result, flags=re.DOTALL)

    return result


def transform_attributes(jsx):
    """Transform JSX attributes to HTML attributes."""
    result = jsx

    # className="..." → class="..."
    result = result.replace('className=', 'class=')

    # className={cn("a", "b")} → class="a b"  (simplified)
    def replace_cn_call(m):
        args = m.group(1)
        # Extract string literals
        strings = re.findall(r'"([^"]*)"', args)
        # Check for variable references
        has_vars = bool(re.search(r'\b[a-z]\w*\b', re.sub(r'"[^"]*"', '', args)))
        merged = " ".join(strings)
        if has_vars:
            return f'class="<%= tw("{merged}", local_assigns[:class]) %>"'
        return f'class="{merged}"'

    result = re.sub(r'class=\{cn\(([^)]+)\)\}', replace_cn_call, result)

    # Other JSX attribute → HTML attribute renames
    for jsx_attr, html_attr in ATTR_MAP.items():
        if jsx_attr == "className":
            continue  # Already handled
        result = re.sub(rf'\b{re.escape(jsx_attr)}=', f'{html_attr}=', result)

    # Boolean JSX attributes: {true} → just the attribute, {false} → remove
    result = re.sub(r'(\w+)=\{true\}', r'\1', result)
    result = re.sub(r'\s+\w+=\{false\}', '', result)

    # Numeric JSX attributes: tabindex={0} → tabindex="0"
    result = re.sub(r'(\w+)=\{(\d+)\}', r'\1="\2"', result)

    # Remove {...props} spread
    result = re.sub(r'\s*\{\.\.\.(?:props|rest)\}', '', result)

    # Remove React ref attributes
    result = re.sub(r'\s+ref=\{[^}]*\}', '', result)

    # Remove React event handlers: onClick={...} etc
    result = re.sub(r'\s+on[A-Z]\w+=\{[^}]*\}', '', result)

    # Remove asChild prop (React-specific)
    result = re.sub(r'\s+asChild\b', '', result)

    # Remove key={...} (React-specific, outside of .map context)
    result = re.sub(r'\s+key=\{[^}]*\}', '', result)
    result = re.sub(r'\s+key="[^"]*"', '', result)

    return result


def transform_jsx_expressions(jsx):
    """Handle remaining JSX expressions { ... }."""
    result = jsx

    # Remove Array.from({length: N}, (_, i) => ...) patterns → static content
    result = re.sub(
        r'\{Array\.from\(\{length:\s*\d+\}.*?\)\}',
        lambda m: f'<%# TODO: Convert Array.from() to static content %>',
        result, flags=re.DOTALL
    )

    # {variable} → <%= variable %> (simple variables, but skip objects/functions)
    def replace_expression(m):
        expr = m.group(1).strip()
        # Skip if it looks like an object literal, function, or complex expression
        if expr.startswith('{') or expr.startswith('(') or '=>' in expr:
            return f'<%# TODO: {expr} %>'
        if expr.startswith('...'):
            return ''  # Spread, already handled
        if expr.startswith('/*'):
            return f'<%# {expr.strip("/* */")} %>'
        # Skip if it's already an ERB expression or contains ERB
        if '<%' in expr or '%>' in expr:
            return m.group(0)
        # Skip if it looks like a .map() call (should have been handled earlier)
        if '.map(' in expr:
            return f'<%# TODO: {expr} %>'
        # Skip .filter(), .find(), .reduce() etc.
        if re.search(r'\.\w+\(', expr) and not re.match(r'^[\w.]+$', expr):
            return f'<%# TODO: {expr} %>'
        # Simple string interpolation
        return f'<%= {expr} %>'

    # Be careful not to match already-converted ERB tags or HTML attributes
    # Only match { } that are not inside HTML attribute values
    result = re.sub(r'(?<!=)\{([^{}]+)\}', replace_expression, result)

    return result


# ---------------------------------------------------------------------------
# Attribute Helpers
# ---------------------------------------------------------------------------

def _extract_attr_value(attrs_str, attr_name):
    """Extract a raw attribute value from a JSX attributes string."""
    m = re.search(rf'{re.escape(attr_name)}="([^"]*)"', attrs_str)
    if m:
        return m.group(1)
    # Also try HTML-style name (e.g. htmlFor → for, id → id)
    html_name = ATTR_MAP.get(attr_name, attr_name)
    if html_name != attr_name:
        m = re.search(rf'{re.escape(html_name)}="([^"]*)"', attrs_str)
        if m:
            return m.group(1)
    return None


def parse_jsx_attrs(attrs_str, prop_map=None):
    """Parse JSX attributes into a dict of Ruby-compatible props."""
    if prop_map is None:
        prop_map = {}
    props = {}

    # className="..."
    cls_match = re.search(r'class(?:Name)?="([^"]*)"', attrs_str)
    if cls_match:
        props["class"] = f'"{cls_match.group(1)}"'

    # className={cn(...)}
    cn_match = re.search(r'class(?:Name)?=\{cn\(([^)]+)\)\}', attrs_str)
    if cn_match:
        strings = re.findall(r'"([^"]*)"', cn_match.group(1))
        props["class"] = f'"{" ".join(strings)}"'

    # variant="..."
    variant_match = re.search(r'variant="([^"]*)"', attrs_str)
    if variant_match:
        props["variant"] = f":{variant_match.group(1)}"

    # size="..."
    size_match = re.search(r'size="([^"]*)"', attrs_str)
    if size_match:
        props["size"] = f":{size_match.group(1)}"

    # type="..."
    type_match = re.search(r'type="([^"]*)"', attrs_str)
    if type_match:
        props["type"] = f'"{type_match.group(1)}"'

    # id="..."
    id_match = re.search(r'id="([^"]*)"', attrs_str)
    if id_match:
        props["id"] = f'"{id_match.group(1)}"'

    # placeholder="..."
    ph_match = re.search(r'placeholder="([^"]*)"', attrs_str)
    if ph_match:
        props["placeholder"] = f'"{ph_match.group(1)}"'

    # required (boolean)
    if re.search(r'\brequired\b', attrs_str):
        props["required"] = "true"

    # disabled (boolean)
    if re.search(r'\bdisabled\b', attrs_str):
        props["disabled"] = "true"

    # asChild → skip (React-specific)

    # Apply prop_map renames
    for jsx_name, html_name in prop_map.items():
        match = re.search(rf'{re.escape(jsx_name)}="([^"]*)"', attrs_str)
        if match:
            props[html_name] = f'"{match.group(1)}"'

    return props


def format_ruby_props(props):
    """Format a dict of props as Ruby keyword arguments."""
    parts = []
    for key, val in props.items():
        if val.startswith(":"):
            parts.append(f'{key}: {val}')
        elif val in ("true", "false"):
            parts.append(f'{key}: {val}')
        else:
            parts.append(f'{key}: {val}')
    return ", ".join(parts)


def extract_classname(attrs_str):
    """Extract className/class value from attrs string."""
    m = re.search(r'class(?:Name)?="([^"]*)"', attrs_str)
    if m:
        return m.group(1)
    cn_match = re.search(r'class(?:Name)?=\{cn\(([^)]+)\)\}', attrs_str)
    if cn_match:
        strings = re.findall(r'"([^"]*)"', cn_match.group(1))
        return " ".join(strings)
    return ""


def remove_classname_attr(attrs_str):
    """Remove className/class attribute from attrs string."""
    result = re.sub(r'\s*class(?:Name)?="[^"]*"', '', attrs_str)
    result = re.sub(r'\s*class(?:Name)?=\{cn\([^)]+\)\}', '', result)
    # Also remove React-specific attrs
    result = re.sub(r'\s*asChild', '', result)
    result = re.sub(r'\s*\{\.\.\.(?:props|rest)\}', '', result)
    # Transform remaining known attrs
    for jsx_attr, html_attr in ATTR_MAP.items():
        result = re.sub(rf'\b{re.escape(jsx_attr)}=', f'{html_attr}=', result)
    return result


def merge_classes(default, extra):
    """Merge default Tailwind classes with extra classes."""
    parts = []
    if default:
        parts.append(default.strip())
    if extra:
        parts.append(extra.strip())
    return " ".join(parts)


# ---------------------------------------------------------------------------
# Generator
# ---------------------------------------------------------------------------

def generate_helper(name, component_type="block"):
    """Generate a Ruby helper file for the component."""
    module_name = snake_to_camel(name.replace("-", "_"))
    helper_name = name.replace("-", "_")

    return textwrap.dedent(f"""\
        module Components::{module_name}Helper
          def render_{helper_name}(**options, &block)
            render "components/ui/{helper_name}", **options, &block
          end
        end
    """)


def generate_block_controller_include(name):
    """Generate the line to include in application layout or controller."""
    helper_name = name.replace("-", "_")
    module_name = snake_to_camel(helper_name)
    return f"include Components::{module_name}Helper"


def snake_to_camel(s):
    """Convert snake_case to CamelCase."""
    return "".join(w.capitalize() for w in s.split("_"))


def sanitize_filename(name):
    """Convert component name to valid file path part."""
    return name.replace("-", "_")


def write_file(path, content, dry_run=False):
    """Write content to file, creating directories as needed."""
    path = Path(path)
    if dry_run:
        print(f"  [DRY RUN] Would write: {path}")
        return

    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w") as f:
        f.write(content)
    print(f"  Created: {path}")


def update_components_json(name, files, comp_type="registry:block"):
    """Add entry to components.json."""
    existing = load_existing_components()
    entry = {
        "name": name,
        "type": comp_type.replace("registry:", "components:") if ":" in comp_type else f"components:{comp_type}",
        "files": [str(f) for f in files],
    }
    existing[name] = entry
    with open(COMPONENTS_JSON, "w") as f:
        json.dump(existing, f, indent=2, ensure_ascii=False)
        f.write("\n")
    print(f"  Updated: {COMPONENTS_JSON}")


# ---------------------------------------------------------------------------
# Main Pipeline
# ---------------------------------------------------------------------------

def process_component(name, style="new-york", url=None, output_dir=None, dry_run=False, local_files=None, github_urls=None, _preloaded_data=None):
    """Main pipeline: fetch/load → parse → transform → generate."""
    print(f"\n{'='*60}")
    print(f"  shadcn_to_rails: Converting '{name}'")
    print(f"{'='*60}\n")

    # 1. Fetch or load local files
    if _preloaded_data:
        data = _preloaded_data
    elif github_urls:
        data = fetch_github(github_urls)
    elif local_files:
        data = load_local_files(local_files)
    else:
        data = fetch_registry(name, style, url)
    if not data:
        print("  FAILED: Could not fetch/load component data.")
        return False

    comp_type = data.get("type", "registry:block")
    description = data.get("description", "")
    print(f"  Type: {comp_type}")
    print(f"  Description: {description}")

    # 2. Check dependencies
    existing = load_existing_components()
    missing = resolve_dependencies(data, existing)
    if missing:
        print(f"\n  WARNING: Missing dependencies: {', '.join(missing)}")
        print(f"  These components are not yet implemented in shadcn-rails.")
        print(f"  The generated code may need manual adjustments.\n")

    # 3. Process each file
    files = data.get("files", [])
    generated_files = []

    for file_info in files:
        tsx_content = file_info.get("content", "")
        file_path = file_info.get("path", "")
        file_type = file_info.get("type", "")

        if not tsx_content:
            continue

        print(f"\n  Processing: {file_path} ({file_type})")

        # Parse imports
        imports = extract_imports(tsx_content)
        icons = imports["icons"]
        if icons:
            print(f"    Icons: {', '.join(sorted(icons))}")

        # Extract props defaults
        props_defaults = extract_props_defaults(tsx_content)
        if props_defaults:
            print(f"    Props: {', '.join(sorted(props_defaults.keys()))}")

        # Extract JSX body
        jsx_body = extract_jsx_body(tsx_content)

        # Determine output paths
        safe_name = sanitize_filename(name)

        # Build partial_prefix for block sub-component render paths
        partial_prefix = ""
        if comp_type == "registry:block":
            partial_prefix = f"blocks/{safe_name}/"

        # Transform to ERB
        erb_content = transform_jsx_to_erb(jsx_body, icons, partial_prefix=partial_prefix, props_defaults=props_defaults)

        if comp_type == "registry:block":
            if output_dir:
                base_dir = PROJECT_ROOT / output_dir
            else:
                base_dir = PROJECT_ROOT / "app" / "views" / "blocks" / safe_name

            if file_type == "registry:page":
                erb_path = base_dir / f"_{safe_name}.html.erb"
            elif file_type == "registry:component":
                # Extract component function name for sub-partial
                func_match = re.search(r'(?:export\s+)?(?:default\s+)?function\s+(\w+)', tsx_content)
                if func_match:
                    sub_name = sanitize_filename(camel_to_snake(func_match.group(1)))
                else:
                    sub_name = Path(file_path).stem.replace("-", "_")
                erb_path = base_dir / f"_{sub_name}.html.erb"
            else:
                erb_path = base_dir / f"_{Path(file_path).stem.replace('-', '_')}.html.erb"

            write_file(erb_path, erb_content + "\n", dry_run)
            generated_files.append(str(erb_path.relative_to(PROJECT_ROOT)))

        elif comp_type == "registry:ui":
            erb_path = PROJECT_ROOT / "app" / "views" / "components" / "ui" / f"_{safe_name}.html.erb"
            helper_path = PROJECT_ROOT / "app" / "helpers" / "components" / f"{safe_name}_helper.rb"

            write_file(erb_path, erb_content + "\n", dry_run)
            generated_files.append(str(erb_path.relative_to(PROJECT_ROOT)))

            if not helper_path.exists():
                helper_content = generate_helper(name)
                write_file(helper_path, helper_content, dry_run)
                generated_files.append(str(helper_path.relative_to(PROJECT_ROOT)))

    # 4. Update components.json
    if generated_files and not dry_run:
        update_components_json(name, generated_files, comp_type)

    # 5. Summary
    print(f"\n{'='*60}")
    print(f"  Done! Generated {len(generated_files)} file(s) for '{name}'")
    for f in generated_files:
        print(f"    - {f}")
    print(f"{'='*60}\n")

    return True


def camel_to_snake(name):
    """Convert CamelCase to snake_case."""
    s1 = re.sub(r'(.)([A-Z][a-z]+)', r'\1_\2', name)
    return re.sub(r'([a-z0-9])([A-Z])', r'\1_\2', s1).lower()


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def _detect_input_type(source):
    """Detect input type from source string.

    Returns: ("github", source) | ("file", source) | ("registry", source)
    """
    if source.startswith("https://github.com") or source.startswith("https://raw.githubusercontent.com"):
        return "github", source
    if Path(source).exists():
        return "file", source
    if source.endswith(".tsx") or source.endswith(".jsx"):
        # Looks like a file path but doesn't exist
        print(f"  WARNING: File not found: {source}")
        return "file", source
    return "registry", source


def _derive_name_from_source(source, input_type):
    """Derive component name from source path/URL.

    Rules:
    - GitHub URL: last path segment without extension (use parent dir if page/index)
    - Local file: stem (filename without extension), parent dir if page/index
    - Local directory: directory name
    - Registry: use as-is
    """
    generic_names = {"page", "index", "component", "src", ".", ""}

    if input_type == "github":
        url_path = source.rstrip("/").split("/")[-1]
        name = url_path.replace(".tsx", "").replace(".jsx", "").replace(".json", "")
        if name.lower() in generic_names:
            # Use parent directory name
            parts = source.rstrip("/").split("/")
            name = parts[-2] if len(parts) >= 2 else name
        return name
    elif input_type == "file":
        p = Path(source)
        if p.is_dir():
            name = p.name
        else:
            name = p.stem
        if name.lower() in generic_names:
            name = p.parent.name if p.parent.name not in generic_names else name
        return name
    else:
        return source


def main():
    parser = argparse.ArgumentParser(
        description="Convert React shadcn/ui components to Rails ERB + Helper",
        epilog="Examples:\n"
               "  python bin/shadcn_to_rails login-03\n"
               "  python bin/shadcn_to_rails https://github.com/user/repo/blob/main/src/block/about3.tsx\n"
               "  python bin/shadcn_to_rails ../shadcn-studio/src/block/about3.tsx\n"
               "  python bin/shadcn_to_rails src/page.tsx src/components/form.tsx\n",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("sources", nargs="*", help="Source(s): registry name, GitHub URL, or local file/directory path")
    parser.add_argument("--style", default="new-york", help="shadcn style (default: new-york)")
    parser.add_argument("--output-dir", help="Custom output directory (relative to project root)")
    parser.add_argument("--dry-run", action="store_true", help="Preview without writing files")
    parser.add_argument("--list-deps", action="store_true", help="Only list dependencies, don't convert")

    args = parser.parse_args()

    if not args.sources:
        parser.print_help()
        sys.exit(1)

    # Classify each source
    github_urls = []
    local_files = []
    registry_name = None

    for source in args.sources:
        input_type, value = _detect_input_type(source)
        if input_type == "github":
            github_urls.append(value)
        elif input_type == "file":
            local_files.append(value)
        else:
            registry_name = value

    # Derive name from first source
    first_source = args.sources[0]
    first_type, _ = _detect_input_type(first_source)
    name = _derive_name_from_source(first_source, first_type)

    if args.list_deps:
        if registry_name:
            data = fetch_registry(registry_name, args.style)
            if data:
                existing = load_existing_components()
                deps = data.get("registryDependencies", [])
                print(f"\nDependencies for '{name}':")
                for dep in deps:
                    status = "OK" if dep in existing else "MISSING"
                    print(f"  [{status}] {dep}")
        else:
            print("  --list-deps only works with registry sources.")
        sys.exit(0)

    # Check if a GitHub directory URL — process each file as a separate block
    if len(github_urls) == 1 and "/tree/" in github_urls[0]:
        data = fetch_github(github_urls)
        if not data:
            sys.exit(1)
        total = len(data["files"])
        ok = 0
        fail = 0
        for file_info in data["files"]:
            fname = Path(file_info["path"]).stem
            single_data = {
                "type": "registry:block",
                "description": file_info["path"],
                "files": [{"path": file_info["path"], "content": file_info["content"], "type": "registry:page"}],
            }
            result = process_component(
                fname,
                style=args.style,
                output_dir=args.output_dir,
                dry_run=args.dry_run,
                _preloaded_data=single_data,
            )
            if result:
                ok += 1
            else:
                fail += 1
        print(f"\n{'='*60}")
        print(f"  Batch complete: {ok} succeeded, {fail} failed out of {total}")
        print(f"{'='*60}\n")
        sys.exit(0 if fail == 0 else 1)

    # Check if a local directory with independent files
    if len(local_files) == 1 and Path(local_files[0]).is_dir():
        dir_path = Path(local_files[0])
        tsx_files = sorted(dir_path.glob("*.tsx")) + sorted(dir_path.glob("*.jsx"))
        if not tsx_files:
            # Maybe nested — fall through to normal processing
            pass
        elif all(not list(f.parent.glob("page.tsx")) or f.name == "page.tsx" for f in tsx_files):
            # Each file is an independent block (no page.tsx structure)
            has_page = any(f.stem.lower() in ("page", "index") for f in tsx_files)
            if not has_page and len(tsx_files) > 1:
                # Independent files — process each separately
                total = len(tsx_files)
                ok = 0
                fail = 0
                for f in tsx_files:
                    result = process_component(
                        f.stem,
                        style=args.style,
                        output_dir=args.output_dir,
                        dry_run=args.dry_run,
                        local_files=[str(f)],
                    )
                    if result:
                        ok += 1
                    else:
                        fail += 1
                print(f"\n{'='*60}")
                print(f"  Batch complete: {ok} succeeded, {fail} failed out of {total}")
                print(f"{'='*60}\n")
                sys.exit(0 if fail == 0 else 1)

    # Single block mode (priority: github > file > registry)
    success = process_component(
        name,
        style=args.style,
        output_dir=args.output_dir,
        dry_run=args.dry_run,
        local_files=local_files if local_files else None,
        github_urls=github_urls if github_urls else None,
    )


if __name__ == "__main__":
    main()
