#!/usr/bin/env python3
"""
shadcn_to_rails: Convert React shadcn/ui components, blocks, and templates to Rails ERB + Helper.

Usage:
    python bin/shadcn_to_rails <component-name> [options]

Examples:
    # Registry API에서 가져오기
    python bin/shadcn_to_rails login-03
    python bin/shadcn_to_rails button
    python bin/shadcn_to_rails --url https://ui.shadcn.com/r/styles/new-york/sidebar-01.json

    # 로컬 TSX 파일 직접 변환
    python bin/shadcn_to_rails my-component --file src/page.tsx
    python bin/shadcn_to_rails my-block --file src/page.tsx --file src/components/form.tsx
    python bin/shadcn_to_rails my-block --file src/            # 디렉토리 내 모든 .tsx
"""

