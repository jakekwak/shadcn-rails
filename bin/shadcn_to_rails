#!/usr/bin/env python3
"""
shadcn_to_rails: Convert React shadcn/ui components, blocks, and templates to Rails ERB + Helper.

Usage:
    python bin/shadcn_to_rails <source> [options]

입력 자동 판별:
    - GitHub URL  → GitHub에서 TSX 가져오기
    - 로컬 파일/디렉토리 → 로컬 TSX 변환
    - 그 외       → shadcn 레지스트리 이름으로 간주

Examples:
    # shadcn 레지스트리
    python bin/shadcn_to_rails login-03

    # GitHub URL (파일 또는 디렉토리)
    python bin/shadcn_to_rails https://github.com/shadcnblocks/shadcn-ui-blocks/blob/master/src/block/about3.tsx
    python bin/shadcn_to_rails https://github.com/shadcnblocks/shadcn-ui-blocks/tree/master/src/block/about3

    # 로컬 파일 또는 디렉토리
    python bin/shadcn_to_rails ../shadcn-studio/src/component/about3.tsx
    python bin/shadcn_to_rails ../shadcn-studio/src/block/about3/

    # 여러 소스 (추가 입력)
    python bin/shadcn_to_rails src/page.tsx src/components/form.tsx
"""

