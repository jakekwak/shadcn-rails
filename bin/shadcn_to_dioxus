#!/usr/bin/env python3
"""
shadcn_to_dioxus: Convert React shadcn/ui components, blocks, and templates to Dioxus RSX (Rust).

Usage:
    python bin/shadcn_to_dioxus <source> [options]

입력 자동 판별:
    - GitHub URL  → GitHub에서 TSX 가져오기
    - 로컬 파일/디렉토리 → 로컬 TSX 변환
    - 그 외       → shadcn 레지스트리 이름으로 간주

Examples:
    # shadcn 레지스트리
    python bin/shadcn_to_dioxus accordion
    python bin/shadcn_to_dioxus login-03

    # GitHub URL
    python bin/shadcn_to_dioxus https://github.com/shadcnblocks/shadcn-ui-blocks/blob/master/src/block/about3.tsx

    # 로컬 파일
    python bin/shadcn_to_dioxus ../shadcn-studio/src/block/about3.tsx

    # 옵션
    python bin/shadcn_to_dioxus login-03 --dry-run
    python bin/shadcn_to_dioxus accordion --list-deps
"""

import argparse
