<% code_items = local_assigns[:code_items] || [] %>
<% code_items.first[:active] = true if code_items.any? && code_items.none? { |item| item[:active] } %>
<div class="rounded-md border overflow-hidden" data-controller="ui--code-block">
  <div class="flex items-center justify-between bg-muted/50 border-b px-4">
    <div class="flex items-center gap-0">
      <% code_items.each_with_index do |item, index| %>
        <button
          type="button"
          data-ui--code-block-target="tab"
          data-state="<%= item[:active] ? 'active' : 'inactive' %>"
          data-index="<%= index %>"
          data-action="ui--code-block#change"
          class="relative px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground data-[state=active]:text-foreground after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:bg-transparent data-[state=active]:after:bg-primary">
          <%= item[:filename] %>
        </button>
      <% end %>
    </div>
    <button
      type="button"
      data-action="ui--code-block#copy"
      data-ui--code-block-target="copyButton"
      class="inline-flex items-center justify-center rounded-md p-1.5 text-muted-foreground hover:text-foreground hover:bg-muted transition-colors"
      title="Copy code">
      <svg data-ui--code-block-target="copyIcon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
      <svg data-ui--code-block-target="checkIcon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    </button>
  </div>
  <div class="relative">
    <% code_items.each_with_index do |item, index| %>
      <div
        data-ui--code-block-target="panel"
        data-state="<%= item[:active] ? 'active' : 'inactive' %>"
        data-code="<%= ERB::Util.html_escape(item[:code]) %>"
        class="code-block overflow-auto bg-zinc-950 dark:bg-zinc-900 p-4 text-sm data-[state=inactive]:hidden">
        <pre class="font-mono text-sm leading-relaxed"><code><%= item[:highlighted].html_safe %></code></pre>
      </div>
    <% end %>
  </div>
</div>
