<section class="bg-background py-32">
  <div class="container">
    <h1 class="text-foreground mb-10 text-center text-3xl font-bold tracking-tighter sm:text-6xl">
      The History of Artificial Intelligence
    </h1>
    <div class="relative mx-auto max-w-4xl">
      <%= render_separator(class: "bg-muted absolute left-2 top-4") %>

      <div class="relative mb-10 pl-8">
        <div class="bg-foreground absolute left-0 top-3.5 flex size-4 items-center justify-center rounded-full"></div>
        <h4 class="rounded-xl py-2 text-xl font-bold tracking-tight xl:mb-4 xl:px-3">
          The Birth of AI
        </h4>
        <h5 class="text-md -left-34 text-muted-foreground top-3 rounded-xl tracking-tight xl:absolute">
          1956
        </h5>
        <%= render_card(class: "w-full my-5 border-none shadow-none") do %>
          <div class="p-6 pt-0 px-0 xl:px-2">
            <div class="prose dark:prose-invert text-foreground">
              The term "Artificial Intelligence" was coined at the Dartmouth Conference, marking the official birth of AI as a field of study.
            </div>
          </div>
        <% end %>
      </div>

      <div class="relative mb-10 pl-8">
        <div class="bg-foreground absolute left-0 top-3.5 flex size-4 items-center justify-center rounded-full"></div>
        <h4 class="rounded-xl py-2 text-xl font-bold tracking-tight xl:mb-4 xl:px-3">
          Expert Systems Era
        </h4>
        <h5 class="text-md -left-34 text-muted-foreground top-3 rounded-xl tracking-tight xl:absolute">
          1980
        </h5>
        <%= render_card(class: "w-full my-5 border-none shadow-none") do %>
          <div class="p-6 pt-0 px-0 xl:px-2">
            <div class="prose dark:prose-invert text-foreground">
              Expert systems became commercially viable, with companies investing heavily in AI research and development for business applications.
            </div>
          </div>
        <% end %>
      </div>

      <div class="relative mb-10 pl-8">
        <div class="bg-foreground absolute left-0 top-3.5 flex size-4 items-center justify-center rounded-full"></div>
        <h4 class="rounded-xl py-2 text-xl font-bold tracking-tight xl:mb-4 xl:px-3">
          Deep Blue Defeats Kasparov
        </h4>
        <h5 class="text-md -left-34 text-muted-foreground top-3 rounded-xl tracking-tight xl:absolute">
          1997
        </h5>
        <%= render_card(class: "w-full my-5 border-none shadow-none") do %>
          <div class="p-6 pt-0 px-0 xl:px-2">
            <div class="prose dark:prose-invert text-foreground">
              IBM's Deep Blue became the first computer to defeat a reigning world chess champion, demonstrating the power of AI in strategic thinking.
            </div>
          </div>
        <% end %>
      </div>

      <div class="relative mb-10 pl-8">
        <div class="bg-foreground absolute left-0 top-3.5 flex size-4 items-center justify-center rounded-full"></div>
        <h4 class="rounded-xl py-2 text-xl font-bold tracking-tight xl:mb-4 xl:px-3">
          The Rise of Deep Learning
        </h4>
        <h5 class="text-md -left-34 text-muted-foreground top-3 rounded-xl tracking-tight xl:absolute">
          2012
        </h5>
        <%= render_card(class: "w-full my-5 border-none shadow-none") do %>
          <div class="p-6 pt-0 px-0 xl:px-2">
            <div class="prose dark:prose-invert text-foreground">
              Deep learning breakthroughs in image recognition sparked a new wave of AI innovation, leading to rapid advances across multiple domains.
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
