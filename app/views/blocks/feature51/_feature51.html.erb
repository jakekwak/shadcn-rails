<% features = [
  { id: "feature-1", heading: "Research", description: "Discover the powerful features that make our platform stand out from the rest.", image: "https://deifkwefumgah.cloudfront.net/shadcnblocks/block/placeholder-1.svg" },
  { id: "feature-2", heading: "Refine", description: "Built with the latest technology and designed for maximum productivity.", image: "https://deifkwefumgah.cloudfront.net/shadcnblocks/block/placeholder-2.svg" },
  { id: "feature-3", heading: "Build", description: "Create amazing experiences with our comprehensive toolkit and resources.", image: "https://deifkwefumgah.cloudfront.net/shadcnblocks/block/placeholder-3.svg" }
] %>
<section class="py-32">
      <div class="container">
        <%= render_tabs do %>
          <% tab_list do %>
            <% features.each_with_index do |feature, index| %>
              <%= tab feature[:heading], id: feature[:id], active: index == 0 %>
            <% end %>
          <% end %>
          <% tab_panels do %>
            <% features.each_with_index do |feature, index| %>
              <%= tab_panel(id: feature[:id], active: index == 0) do %>
                <div class="mt-2">
                  <img
                    src="<%= feature[:image] %>"
                    alt="<%= feature[:heading] %>"
                    class="aspect-video w-full rounded-md object-cover"
                  />
                </div>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </section>
