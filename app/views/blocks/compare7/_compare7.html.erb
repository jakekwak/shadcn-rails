<section class="py-32">
      <div class="container">
        <h2 class="mb-4 text-center text-4xl font-semibold">Compare Us</h2>
        <p class="text-muted-foreground mb-8 text-center">
          A modern framework for building websites that is better than the
          competition.
        </p>
        <div class="mx-auto max-w-3xl overflow-x-auto">
          <%= render_table(class: "rounded border text-left shadow-lg") do %>
<thead class="[&_tr]:border-b">
              <tr class="border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted">
                <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground"></th>
                <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground bg-muted px-6 py-4 font-semibold">
                  Shadcn
                </th>
                <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground px-6 py-4 font-semibold">
                  Bootstrap
                </th>
              </tr>
            </thead>
            <tbody class="[&_tr:last-child]:border-0 text-foreground">
              <tr class="border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted">
                <td class="p-4 align-middle px-6 py-4">Design System</td>
                <td class="p-4 align-middle bg-muted px-6 py-4">
                  Modern, Utility-first
                </td>
                <td class="p-4 align-middle px-6 py-4">
                  Classic, Component-based
                </td>
              </tr>
              <tr class="border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted">
                <td class="p-4 align-middle px-6 py-4">Customization</td>
                <td class="p-4 align-middle bg-muted px-6 py-4">
                  Highly customizable
                </td>
                <td class="p-4 align-middle px-6 py-4">Limited by default</td>
              </tr>
              <tr class="border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted">
                <td class="p-4 align-middle px-6 py-4">Dark Mode</td>
                <td class="p-4 align-middle bg-muted px-6 py-4">Built-in</td>
                <td class="p-4 align-middle px-6 py-4">
                  Requires extra setup
                </td>
              </tr>
              <tr class="border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted">
                <td class="p-4 align-middle px-6 py-4">TypeScript Support</td>
                <td class="p-4 align-middle bg-muted px-6 py-4">
                  First-class
                </td>
                <td class="p-4 align-middle px-6 py-4">Partial</td>
              </tr>
              <tr class="border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted">
                <td class="p-4 align-middle px-6 py-4">Accessibility</td>
                <td class="p-4 align-middle bg-muted px-6 py-4">
                  Focus on a11y
                </td>
                <td class="p-4 align-middle px-6 py-4">Basic</td>
              </tr>
              <tr class="border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted">
                <td class="p-4 align-middle px-6 py-4">Component Count</td>
                <td class="p-4 align-middle bg-muted px-6 py-4">30+</td>
                <td class="p-4 align-middle px-6 py-4">25+</td>
              </tr>
              <tr class="border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted">
                <td class="p-4 align-middle px-6 py-4">License</td>
                <td class="p-4 align-middle bg-muted px-6 py-4">MIT</td>
                <td class="p-4 align-middle px-6 py-4">MIT</td>
              </tr>
              <tr class="border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted">
                <td class="p-4 align-middle px-6 py-4">Premium Components</td>
                <td class="p-4 align-middle bg-muted px-6 py-4">Available</td>
                <td class="p-4 align-middle relative px-6 py-4">
                  <%= render_tooltip do %>
<span>
                      <span class="cursor-pointer underline decoration-dotted">
                        Not included
                      </span>
                    </span>
                    <div class="z-50 overflow-hidden rounded-md border bg-popover px-3 py-1.5 text-sm text-popover-foreground shadow-md max-w-xs" sideOffset="8">
                      <span class="mb-1 block font-semibold">
                        Premium Only
                      </span>
                      Some advanced components are only available in paid
                      versions or require third-party libraries.
                    </div>
<% end %>
                </td>
              </tr>
              <tr class="border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted">
                <td class="p-4 align-middle px-6 py-4">Figma Kit</td>
                <td class="p-4 align-middle bg-muted px-6 py-4">Yes</td>
                <td class="p-4 align-middle relative px-6 py-4">
                  <%= render_tooltip do %>
<span>
                      <span class="text-muted-foreground cursor-pointer underline decoration-dotted">
                        No
                      </span>
                    </span>
                    <div class="z-50 overflow-hidden rounded-md border bg-popover px-3 py-1.5 text-sm text-popover-foreground shadow-md max-w-xs" sideOffset="8">
                      <span class="mb-1 block font-semibold">
                        Figma Kit Unavailable
                      </span>
                      Bootstrap does not provide an official Figma kit, but
                      community kits may exist.
                    </div>
<% end %>
                </td>
              </tr>
            </tbody>
<% end %>
        </div>
      </div>
    </section>
