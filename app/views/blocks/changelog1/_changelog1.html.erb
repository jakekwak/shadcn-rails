<section class="py-32">
      <div class="container">
        <div class="mx-auto max-w-3xl">
          <h1 class="mb-4 text-3xl font-bold tracking-tight md:text-5xl">
            Changelog
          </h1>
          <p class="text-muted-foreground mb-6 text-base md:text-lg">
            Get the latest updates and improvements to our platform.
          </p>
        </div>
        <div class="mx-auto mt-16 max-w-3xl space-y-16 md:mt-24 md:space-y-24">
          <div class="relative flex flex-col gap-4 md:flex-row md:gap-16">
            <div class="top-8 flex h-min w-64 shrink-0 items-center gap-4 md:sticky">
              <%= render_badge("Version 1.3.0", class: "text-xs", variant: :secondary) %>
              <span class="text-muted-foreground text-xs font-medium">15 November 2024</span>
            </div>
            <div class="flex flex-col">
              <h2 class="text-foreground/90 mb-3 text-lg font-bold leading-tight md:text-2xl">
                Enhanced Analytics Dashboard
              </h2>
              <p class="text-muted-foreground text-sm md:text-base">
                We've completely redesigned our analytics dashboard to provide deeper insights and improved visualizations of your data.
              </p>
              <ul class="text-muted-foreground ml-4 mt-4 space-y-1.5 text-sm md:text-base">
                <li class="list-disc">Real-time data visualization with interactive charts</li>
                <li class="list-disc">Custom date range filters and comparison tools</li>
                <li class="list-disc">Export reports in PDF and CSV formats</li>
              </ul>
              <img
                src="https://deifkwefumgah.cloudfront.net/shadcnblocks/block/placeholder-aspect-video-1.svg"
                alt="Version 1.3.0 visual"
                class="mt-8 w-full rounded-lg object-cover"
              />
              <%= render_button(class: "mt-4 self-end", variant: :link) do %>
                Learn more
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
              <% end %>
            </div>
          </div>

          <div class="relative flex flex-col gap-4 md:flex-row md:gap-16">
            <div class="top-8 flex h-min w-64 shrink-0 items-center gap-4 md:sticky">
              <%= render_badge("Version 1.2.5", class: "text-xs", variant: :secondary) %>
              <span class="text-muted-foreground text-xs font-medium">7 October 2024</span>
            </div>
            <div class="flex flex-col">
              <h2 class="text-foreground/90 mb-3 text-lg font-bold leading-tight md:text-2xl">
                Mobile App Launch
              </h2>
              <p class="text-muted-foreground text-sm md:text-base">
                We're excited to announce the launch of our mobile application, available now on iOS and Android platforms.
              </p>
              <ul class="text-muted-foreground ml-4 mt-4 space-y-1.5 text-sm md:text-base">
                <li class="list-disc">Native iOS and Android applications</li>
                <li class="list-disc">Push notifications for real-time updates</li>
                <li class="list-disc">Offline mode for key features</li>
              </ul>
            </div>
          </div>

          <div class="relative flex flex-col gap-4 md:flex-row md:gap-16">
            <div class="top-8 flex h-min w-64 shrink-0 items-center gap-4 md:sticky">
              <%= render_badge("Version 1.2.1", class: "text-xs", variant: :secondary) %>
              <span class="text-muted-foreground text-xs font-medium">23 September 2024</span>
            </div>
            <div class="flex flex-col">
              <h2 class="text-foreground/90 mb-3 text-lg font-bold leading-tight md:text-2xl">
                New features and improvements
              </h2>
              <p class="text-muted-foreground text-sm md:text-base">
                Here are the latest updates and improvements to our platform. We are always working to improve our platform and your experience.
              </p>
              <ul class="text-muted-foreground ml-4 mt-4 space-y-1.5 text-sm md:text-base">
                <li class="list-disc">Improved search functionality with filters</li>
                <li class="list-disc">Bug fixes and performance improvements</li>
              </ul>
              <img
                src="https://deifkwefumgah.cloudfront.net/shadcnblocks/block/placeholder-aspect-video-1.svg"
                alt="Version 1.2.1 visual"
                class="mt-8 w-full rounded-lg object-cover"
              />
            </div>
          </div>

          <div class="relative flex flex-col gap-4 md:flex-row md:gap-16">
            <div class="top-8 flex h-min w-64 shrink-0 items-center gap-4 md:sticky">
              <%= render_badge("Version 1.0.0", class: "text-xs", variant: :secondary) %>
              <span class="text-muted-foreground text-xs font-medium">31 August 2024</span>
            </div>
            <div class="flex flex-col">
              <h2 class="text-foreground/90 mb-3 text-lg font-bold leading-tight md:text-2xl">
                First version of our platform
              </h2>
              <p class="text-muted-foreground text-sm md:text-base">
                Introducing a new platform to help you manage your projects and tasks. We are excited to launch our platform and help you get started. We are always working to improve our platform and your experience.
              </p>
              <ul class="text-muted-foreground ml-4 mt-4 space-y-1.5 text-sm md:text-base">
                <li class="list-disc">Project management dashboard</li>
                <li class="list-disc">Task tracking and collaboration tools</li>
                <li class="list-disc">Team management and permissions</li>
              </ul>
              <img
                src="https://deifkwefumgah.cloudfront.net/shadcnblocks/block/placeholder-aspect-video-1.svg"
                alt="Version 1.0.0 visual"
                class="mt-8 w-full rounded-lg object-cover"
              />
              <%= render_button(class: "mt-4 self-end", variant: :link) do %>
                Learn more
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </section>
